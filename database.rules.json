{
  "rules": {
    "sync": {
      "$uid": {
        // Only allow users to read/write their own data
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "usernames": {
      // Denying parent read blocks mass enumeration/listing of all emails
      ".read": false,
      "$username": {
        // Allow single handle lookups during authentication
        ".read": "true",
        // Allow writing only if the username is unclaimed OR if the logged-in user is claiming/updating their own mapped email
        ".write": "!data.exists() || data.val() === auth.token.email"
      }
    }
  }
}
